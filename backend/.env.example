# Server Configuration
PORT=5000
NODE_ENV=development
SALON_TIMEZONE=Asia/Kolkata
DEFAULT_SALON_NAME="Velora Salon"

# Database Configuration (Supabase PostgreSQL Free Tier via Supavisor Pooler)
# IMPORTANT: Render Free is IPv4-only. Do not use direct db.[PROJECT_REF].supabase.co (which resolves to IPv6).
# 1. Runtime Connection: Supabase Transaction Pooler (Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# 2. Migrations & DDL Connection: Supabase Session Pooler (Port 5432)
# Supports schema migrations, table creation, and locks in IPv4 environments like Render and local dev.
MIGRATION_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# TLS certificate verification (required in production):
# Set this to the path of the Supabase CA certificate downloaded from your project settings.
# Local development without this CA uses encrypted TLS but does not verify server identity.
# DATABASE_SSL_CA="C:\\path\\to\\supabase-ca.crt"

# Security & Staff Authentication (In-House JWT - No paid external auth services)
JWT_SECRET="generate-a-secure-random-64-character-hex-string-for-production"
JWT_EXPIRES_IN="8h"

# CORS Configuration (Allowed frontend origin)
CORS_ORIGIN="http://localhost:5173"
